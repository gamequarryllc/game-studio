{
  "expo": {
    "name": "Roomfile",
    "slug": "home-inventory",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roomfile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gamequarry.homeinventory",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gamequarry.homeinventory"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#131210"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Roomfile uses the camera to photograph your belongings and receipts. Photos stay on this iPhone.",
          "photosPermission": "Roomfile lets you add photos of your belongings and receipts from your library. Photos stay on this iPhone."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
