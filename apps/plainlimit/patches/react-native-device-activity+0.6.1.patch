+/// Plainlimit: whether a checkpoint came sooner than its pace rule allows:
+/// less than `ms` after the stored time of any listed earlier report. Reports
+/// stored between `skipFrom` and `skipTo` (just after the day was registered,
+/// when the phone re-reports the day with fresh times) are left out.
+func plainlimitTooSoon(pace: [String: Any]) -> Bool {
+  let now = Date().timeIntervalSince1970 * 1000
+  let skipFrom = (pace["skipFrom"] as? NSNumber)?.doubleValue ?? 0
+  let skipTo = (pace["skipTo"] as? NSNumber)?.doubleValue ?? 0
+  guard let after = pace["after"] as? [[String: Any]] else { return false }
+  CFPreferencesAppSynchronize(kCFPreferencesCurrentApplication)
+  for rule in after {
+    guard let key = rule["key"] as? String, let ms = (rule["ms"] as? NSNumber)?.doubleValue,
+      let at = (userDefaults?.object(forKey: key) as? NSNumber)?.doubleValue, at > 0
+    else { continue }
+    if skipTo > skipFrom && at >= skipFrom && at <= skipTo { continue }
+    if at < now && now < at + ms { return true }
+  }
+  return false
+}
