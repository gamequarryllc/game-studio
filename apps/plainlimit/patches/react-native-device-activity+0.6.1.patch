 var store = ManagedSettingsStore()
 
+// Plainlimit patch: iOS shields at most 50 single apps per settings store (with
+// more, it shields none of them). Single apps past the first 50 go into extra
+// named stores, 50 each, so a list of up to 500 single apps still locks.
+//
+// A list of 50 single apps or fewer never touches the extra stores: it is
+// shielded exactly as the library does it unpatched. (Build 86 made all nine
+// extra stores and wrote to each of them on every change, before the
+// categories were shielded; on the owner's phone the battery ran empty and
+// nothing locked. The monitor extension has very little memory and time, so
+// the extra work now only happens for a list that needs it, and comes last.)
+let APPS_PER_STORE = 50
+let EXTRA_STORES_MOST = 9
+let EXTRA_STORES_KEY = "plainlimit_extra_stores"
+
+@available(iOS 16.0, *)
+func extraAppStore(_ number: Int) -> ManagedSettingsStore {
+  return ManagedSettingsStore(named: ManagedSettingsStore.Name("plainlimit-apps-\(number)"))
+}
+
+/// How many extra stores hold apps now (0 for nearly every list).
+func extraAppStoresInUse() -> Int {
+  return min(max(userDefaults?.integer(forKey: EXTRA_STORES_KEY) ?? 0, 0), EXTRA_STORES_MOST)
+}
+
+func appChunks(_ tokens: Set<ApplicationToken>) -> [Set<ApplicationToken>] {
+  if tokens.count <= APPS_PER_STORE { return [tokens] }
+  let all = Array(tokens)
+  return stride(from: 0, to: all.count, by: APPS_PER_STORE).map {
+    Set(all[$0..<min($0 + APPS_PER_STORE, all.count)])
+  }
+}
+
+/// Puts the chunks after the first into the extra stores, and empties any extra store no longer needed.
+@available(iOS 16.0, *)
+func shieldExtraApplications(_ chunks: [Set<ApplicationToken>]) {
+  let before = extraAppStoresInUse()
+  let needed = min(max(chunks.count - 1, 0), EXTRA_STORES_MOST)
+  if before == 0 && needed == 0 { return }
+  for number in 1...max(before, needed) {
+    extraAppStore(number).shield.applications = number <= needed ? chunks[number] : nil
+  }
+  userDefaults?.set(needed, forKey: EXTRA_STORES_KEY)
+}
+
+@available(iOS 16.0, *)
+func allShieldedApplications() -> Set<ApplicationToken> {
+  var all = store.shield.applications ?? Set()
+  let inUse = extraAppStoresInUse()
+  if inUse > 0 {
+    for number in 1...inUse { all.formUnion(extraAppStore(number).shield.applications ?? Set()) }
+  }
+  return all
+}
+
 @available(iOS 15.0, *)
