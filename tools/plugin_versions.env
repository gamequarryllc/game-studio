# Pinned versions of the native ad and store plugins (copied from the studio's
# reference game, Melt a Glacier). tools/fetch_plugins.sh and the iOS workflow
# read this file. The GDScript halves live in each game's addons/ folder; their
# plugin.cfg versions must match these (fetch_plugins.sh checks).
#
# Both plugins need Godot 4.7.2: a game takes them only once its
# games/<slug>/godot_version.txt says 4.7.2. When the engine version changes,
# the AdMob release must have an ios-template-v<version>.zip asset (check its
# Releases page) before the game moves.
PLUGIN_GODOT_VERSION=4.7.2
ADMOB_PLUGIN_VERSION=v5.1.0
REVENUECAT_PLUGIN_VERSION=2.6.0
