extends Node
## Autoload "Sound": every sound effect and the ambience.
##
## All audio is generated by art/audio/make_sfx.py (no stock sounds) into
## audio/sfx/. play() for one-off sounds, loop() for continuous ones (pumps,
## waves). "name" finds name.ogg, or name_1.ogg, name_2.ogg... and picks one.
## Buses: Music, Ambience, SFX. Volumes and mute live in user://settings.cfg,
## apart from the save, so starting over keeps them. Everything goes quiet
## during ads and while the browser tab is hidden.

const SFX_DIR := "res://audio/sfx/"
const SETTINGS_PATH := "user://settings.cfg"
const VOICES := 12

var sfx_volume := 0.9
var music_volume := 0.7
var muted := false

var _bank := {}
var _voices: Array = []
var _next := 0
var _cooldown := {}
var _loops := {}            # id -> {player, name, vol, want, db}
var _hush := false
var _web_check := 0.0
var _web_hidden := false
var _clock := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_settings()
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_voices.append(p)
	_apply_volumes()


func streams(name: String) -> Array:
	if _bank.has(name):
		return _bank[name]
	var list: Array = []
	if ResourceLoader.exists(SFX_DIR + name + ".ogg"):
		list.append(load(SFX_DIR + name + ".ogg"))
	else:
		var i := 1
		while ResourceLoader.exists(SFX_DIR + "%s_%d.ogg" % [name, i]):
			list.append(load(SFX_DIR + "%s_%d.ogg" % [name, i]))
			i += 1
	_bank[name] = list
	return list


func _pick(name: String) -> AudioStream:
	var list := streams(name)
	return null if list.is_empty() else list[randi() % list.size()]


func play(name: String, volume_db: float = 0.0, pitch: float = 1.0, pitch_var: float = 0.0, gap: float = 0.0) -> void:
	if _hush:
		return
	if gap > 0.0:
		if _clock < float(_cooldown.get(name, -1.0)):
			return
		_cooldown[name] = _clock + gap
	var s := _pick(name)
	if s == null:
		return
	var p: AudioStreamPlayer = _voices[_next]
	_next = (_next + 1) % _voices.size()
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = maxf(0.05, pitch * (1.0 + randf_range(-pitch_var, pitch_var)))
	p.play()


func loop(id: String, name: String, on: bool, volume_db: float = 0.0, pitch: float = 1.0, bus: String = "SFX") -> void:
	## A continuous sound that fades in while `on` and out after.
	var l: Dictionary = _loops.get(id, {})
	if l.is_empty():
		if not on:
			return
		var p := AudioStreamPlayer.new()
		p.bus = bus
		p.playback_type = AudioServer.PLAYBACK_TYPE_STREAM
		add_child(p)
		l = {"player": p, "name": "", "vol": 0.0, "want": 0.0, "db": volume_db}
		_loops[id] = l
	var pl: AudioStreamPlayer = l.player
	if on and l.name != name:
		var s := _pick(name)
		if s == null:
			return
		if s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = true
		pl.stream = s
		l.name = name
		pl.play()
	l.want = 1.0 if on else 0.0
	l.db = volume_db
	pl.pitch_scale = pitch


func _process(delta: float) -> void:
	_clock += delta
	_web_check -= delta
	if _web_check <= 0.0:
		_web_check = 0.5
		if OS.has_feature("web") and ClassDB.class_exists("JavaScriptBridge"):
			_web_hidden = bool(JavaScriptBridge.eval("document.hidden", true))
	var hush := _web_hidden or Monetization.is_showing_ad()
	if hush != _hush:
		_hush = hush
		_apply_volumes()
	for id in _loops:
		var l: Dictionary = _loops[id]
		var pl: AudioStreamPlayer = l.player
		l.vol = move_toward(float(l.vol), float(l.want), delta * (3.0 if float(l.want) > float(l.vol) else 2.0))
		if float(l.vol) <= 0.001:
			if pl.playing:
				pl.stop()
				l.name = ""
		else:
			if not pl.playing:
				pl.play()
			pl.volume_db = float(l.db) + linear_to_db(float(l.vol))


func stop_loops() -> void:
	for id in _loops:
		_loops[id].want = 0.0


# --- Settings ------------------------------------------------------------------------------
func set_muted(on: bool) -> void:
	muted = on
	_apply_volumes()
	_save_settings()


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func set_music_volume(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func _apply_volumes() -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), muted or _hush)
	var sfx := AudioServer.get_bus_index("SFX")
	if sfx >= 0:
		AudioServer.set_bus_volume_db(sfx, linear_to_db(maxf(sfx_volume, 0.0001)))
	for b in ["Ambience", "Music"]:
		var i := AudioServer.get_bus_index(b)
		if i >= 0:
			AudioServer.set_bus_volume_db(i, linear_to_db(maxf(music_volume, 0.0001)))


func _load_settings() -> void:
	var c := ConfigFile.new()
	if c.load(SETTINGS_PATH) != OK:
		return
	sfx_volume = float(c.get_value("audio", "sfx", sfx_volume))
	music_volume = float(c.get_value("audio", "music", music_volume))
	muted = bool(c.get_value("audio", "muted", muted))


func _save_settings() -> void:
	var c := ConfigFile.new()
	c.set_value("audio", "sfx", sfx_volume)
	c.set_value("audio", "music", music_volume)
	c.set_value("audio", "muted", muted)
	c.save(SETTINGS_PATH)
