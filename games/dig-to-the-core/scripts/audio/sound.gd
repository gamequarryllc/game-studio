extends Node
## Autoload "Sound": every sound effect and the ambience.
##
## All audio is generated by art/audio/make_sfx.py (no stock sounds), into
## audio/sfx/. Game code calls play() / play_at() for one-off sounds and
## loop() for continuous ones (the jackhammer, the drill, the lift).
## "name" finds name.ogg, or name_1.ogg, name_2.ogg... and picks one.
##
## Buses: Music, Ambience, SFX (default_bus_layout.tres). Volumes and mute live
## in user://settings.cfg, apart from the save, so starting over keeps them.
## Web: loops are mixed by Godot ("stream" playback) because the browser's
## sample playback leaves a tiny gap each time a loop restarts. Everything
## goes quiet during ads and while the tab is hidden.

const SFX_DIR := "res://audio/sfx/"
const SETTINGS_PATH := "user://settings.cfg"
const VOICES_2D := 10
const VOICES_3D := 10

var sfx_volume := 0.9
var music_volume := 0.7
var muted := false

var _bank := {}
var _v2d: Array = []
var _v3d: Array = []
var _next2d := 0
var _next3d := 0
var _cooldown := {}
var _loops := {}            # id -> {player, vol, want, rate}
var _hush := false
var _web_check := 0.0
var _web_hidden := false
var _clock := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_settings()
	for i in VOICES_2D:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_v2d.append(p)
	for i in VOICES_3D:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p.max_distance = 40.0
		p.unit_size = 4.0
		add_child(p)
		_v3d.append(p)
	_apply_volumes()


func streams(name: String) -> Array:
	if _bank.has(name):
		return _bank[name]
	var list: Array = []
	for ext in [".ogg", ".wav"]:
		if ResourceLoader.exists(SFX_DIR + name + ext):
			list.append(load(SFX_DIR + name + ext))
			break
	if list.is_empty():
		var i := 1
		while ResourceLoader.exists(SFX_DIR + "%s_%d.ogg" % [name, i]):
			list.append(load(SFX_DIR + "%s_%d.ogg" % [name, i]))
			i += 1
	if list.is_empty():
		push_warning("Sound: no audio called '%s'" % name)
	_bank[name] = list
	return list


func _pick(name: String) -> AudioStream:
	var list := streams(name)
	return null if list.is_empty() else list[randi() % list.size()]


func _ok(name: String, gap: float) -> bool:
	if gap <= 0.0:
		return true
	if _clock < float(_cooldown.get(name, -1.0)):
		return false
	_cooldown[name] = _clock + gap
	return true


func play(name: String, volume_db: float = 0.0, pitch: float = 1.0, pitch_var: float = 0.0, gap: float = 0.0) -> void:
	if _hush or not _ok(name, gap):
		return
	var s := _pick(name)
	if s == null:
		return
	var p: AudioStreamPlayer = _v2d[_next2d]
	_next2d = (_next2d + 1) % _v2d.size()
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = maxf(0.05, pitch * (1.0 + randf_range(-pitch_var, pitch_var)))
	p.play()


func play_at(name: String, at: Vector3, volume_db: float = 0.0, pitch: float = 1.0, pitch_var: float = 0.0, gap: float = 0.0) -> void:
	if _hush or not _ok(name, gap):
		return
	var s := _pick(name)
	if s == null:
		return
	var p: AudioStreamPlayer3D = _v3d[_next3d]
	_next3d = (_next3d + 1) % _v3d.size()
	p.stream = s
	p.global_position = at
	p.volume_db = volume_db
	p.pitch_scale = maxf(0.05, pitch * (1.0 + randf_range(-pitch_var, pitch_var)))
	p.play()


func loop(id: String, name: String, on: bool, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	## A continuous sound that fades in while `on` and out after.
	var l: Dictionary = _loops.get(id, {})
	if l.is_empty():
		if not on:
			return
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		p.playback_type = AudioServer.PLAYBACK_TYPE_STREAM
		add_child(p)
		l = {"player": p, "name": "", "vol": 0.0, "want": 0.0, "db": volume_db}
		_loops[id] = l
	var pl: AudioStreamPlayer = l.player
	if on and l.name != name:
		var s := _pick(name)
		if s == null:
			return
		if s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = true
		elif s is AudioStreamWAV:
			(s as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
		pl.stream = s
		l.name = name
		pl.play()
	l.want = 1.0 if on else 0.0
	l.db = volume_db
	pl.pitch_scale = pitch


func _process(delta: float) -> void:
	_clock += delta
	_web_check -= delta
	if _web_check <= 0.0:
		_web_check = 0.5
		if OS.has_feature("web") and ClassDB.class_exists("JavaScriptBridge"):
			_web_hidden = bool(JavaScriptBridge.eval("document.hidden", true))
	var hush := _web_hidden or Monetization.is_showing_ad()
	if hush != _hush:
		_hush = hush
		AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), _hush or muted)
	for id in _loops:
		var l: Dictionary = _loops[id]
		var pl: AudioStreamPlayer = l.player
		l.vol = move_toward(float(l.vol), float(l.want), delta * (8.0 if float(l.want) > float(l.vol) else 4.0))
		if float(l.vol) <= 0.001:
			if pl.playing:
				pl.stop()
				l.name = ""
		else:
			if not pl.playing:
				pl.play()
			pl.volume_db = float(l.db) + linear_to_db(float(l.vol))


func stop_loops() -> void:
	for id in _loops:
		_loops[id].want = 0.0


# --- Settings ------------------------------------------------------------------------------
func set_muted(on: bool) -> void:
	muted = on
	_apply_volumes()
	_save_settings()


func set_sfx_volume(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func set_music_volume(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func _apply_volumes() -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), muted or _hush)
	var sfx := AudioServer.get_bus_index("SFX")
	if sfx >= 0:
		AudioServer.set_bus_volume_db(sfx, linear_to_db(maxf(sfx_volume, 0.0001)))
	var amb := AudioServer.get_bus_index("Ambience")
	if amb >= 0:
		AudioServer.set_bus_volume_db(amb, linear_to_db(maxf(music_volume, 0.0001)))
	var mus := AudioServer.get_bus_index("Music")
	if mus >= 0:
		AudioServer.set_bus_volume_db(mus, linear_to_db(maxf(music_volume, 0.0001)))


func _load_settings() -> void:
	var c := ConfigFile.new()
	if c.load(SETTINGS_PATH) != OK:
		return
	sfx_volume = float(c.get_value("audio", "sfx", sfx_volume))
	music_volume = float(c.get_value("audio", "music", music_volume))
	muted = bool(c.get_value("audio", "muted", muted))


func _save_settings() -> void:
	var c := ConfigFile.new()
	c.set_value("audio", "sfx", sfx_volume)
	c.set_value("audio", "music", music_volume)
	c.set_value("audio", "muted", muted)
	c.save(SETTINGS_PATH)
